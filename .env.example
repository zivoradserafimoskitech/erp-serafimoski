# ===== ERP Серафимоски Тек — Environment Variables =====
# Копирај во .env и пополни ги вредностите.
# Базата е PostgreSQL (не MySQL).

# Задолжително: PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/serafimoski

# SSL кон базата (на Railway/Render обично вклучено; локално често false)
# DATABASE_SSL=false

# Автентикација (fail-safe ЗАТВОРЕНО по подразбирање)
# Варијанта A: главна лозинка на серверот
# APP_PASSWORD=change-me-strong-password
# Варијанта B: создај администратор при прв старт (UI setup екран)
# Варијанта C (САМО локално / тестови — НИКОГАШ продукција):
# DISABLE_USER_GATE=true

# Криптирање на дигитални сертификати (generate: openssl rand -hex 32)
CERT_ENCRYPTION_KEY=your-cert-encryption-key

# Опционално: JWT / legacy
# JWT_SECRET=your-jwt-secret-here

# Frontend API URL (за production build; празно = релативен /api/trpc)
# VITE_API_URL=/api/trpc

# Порт на серверот (default 3000)
# PORT=3000

# Email IMAP (опционално — прием на фактури)
# EMAIL_IMAP_HOST=mail.vashdomain.mk
# EMAIL_IMAP_PORT=993
# EMAIL_IMAP_SECURE=true
# EMAIL_USER=erp@vashdomain.mk
# EMAIL_PASS=your-email-password

# ===== УЈП е-фактура =====
# Тест (default): симулација без сертификат ако нема cert / UJP_ENV!=production
# UJP_ENV=test
# UJP_API_KEY=
# Продукција (постави на Railway/Render Variables):
# UJP_ENV=production
# UJP_API_KEY=<клуч од УЈП портал>
# + дигитален сертификат во апликацијата (Подесувања / сертификати)
# Без production + клуч + cert, испраќањето останува тест/симулација.
# Status callback и масовно испраќање бараат реален УЈП пристап.


# Оперативни прекинувачи
# Авто-миграции при старт (getInitSql + init-db-v2 IF NOT EXISTS). Не исклучувај на продукција.
# SKIP_AUTO_MIGRATE=true
# DISABLE_AUTO_LEDGER=true
# DISABLE_REMINDERS=true

# ===== Кредитен лимит =====
# false (default): само предупредување на понуда кога клиентот е над лимит
# true: блокира зачувување на понуда кога creditCheck.blocked (над лимит)
CREDIT_LIMIT_STRICT=false


# ===== Маркетинг: форма на веб-страницата, е-пошта, feed =====
# Домени што смеат да праќаат барања до /api/public/* (CORS). serafimoski.tech и www.serafimoski.tech
# се секогаш дозволени; тука додај други (staging, localhost), одделени со запирка.
# ALLOWED_ORIGINS=https://staging.serafimoski.tech,http://localhost:5174
# Јавна адреса на ERP-то (линкови во интерните е-пораки и во „Веб каталог“).
# ЗАДОЛЖИТЕЛНО за е-пошта кампањи и double opt-in: од неа се градат линковите за одјава, следење клик/отворање и потврда.
# APP_URL=https://web-production-dceb8.up.railway.app
# Барања по IP за 10 минути (заштита од спам; default 5)
# LEAD_RATE_LIMIT=5

# Е-пошта за праќање (автоматски одговор, известувања). Подесувања → Фирма → SMTP има предност пред env.
# SMTP (на пр. Titan: smtp.titan.email, 465)
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=ponudi@serafimoski.tech
# SMTP_PASS=
# SMTP_FROM="Серафимоски <ponudi@serafimoski.tech>"
# Или преку API на провајдер (за масовни кампањи): MAIL_PROVIDER=smtp | brevo | mailgun
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=
# MAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.serafimoski.tech
# MAILGUN_REGION=eu
# Amazon SES: користи го неговиот SMTP интерфејс (SMTP_HOST=email-smtp.eu-central-1.amazonaws.com …)
# Испраќач за API провајдерите (ако не е поставен SMTP_FROM)
# MAIL_FROM="Серафимоски <ponudi@serafimoski.tech>"

# Product feed за Meta / Google Merchant (/api/public/feed/meta.csv, /api/public/feed/google.xml)
# Ако е поставено, feed-от бара ?key=<FEED_TOKEN>
# FEED_TOKEN=
# FEED_BRAND=Serafimoski
# PUBLIC_SITE_URL=https://serafimoski.tech

# Маркетинг планер: редица за кампањи (секоја минута, по „пораки/мин“ од кампањата)
# и усогласување извор → нарачка → фактура. true = исклучен (кампањите тогаш се праќаат само со „Прати серија“).
# MARKETING_SCHEDULER_DISABLED=true
# Тајна за потпис на линковите за следење клик (спречува open-redirect). Ако не е поставена,
# се генерира еднаш и се чува во базата (app_kv). Постави ја ако сакаш да ја контролираш/ротираш.
# MARKETING_SECRET=
